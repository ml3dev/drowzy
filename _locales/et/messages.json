  "changelog135Desc3": {
    "message": "Uus rida seadetes näitab otseteede olekut ja viib otse nende kohandamiseni."
  },
  "changelog135Title4": {
    "message": "Statistika ja jagamise täiustused"
  },
  "changelog135Desc4": {
    "message": "Statistika jagamine kuvatakse nüüd sinu keeles ja mälu kogusummad on korralikud, näiteks 2 GB asemel 2,0 GB."
  },
  "changelog135Title5": {
    "message": "Viimistlus ja juurdepääsetavus"
  },
  "changelog135Desc5": {
    "message": "Selgemad ikoonid, brändivärvides tööriistariba märk, paremad ekraanilugeja sildid ja korralikum hüpikaken."
  },
  "suspendThisTabHint": {
    "message": "Mine teisele kaardile ja pane see uinakule"
  },
  "changelog137Title1": {
    "message": "Pane üks kaart uuesti uinakule"
  },
  "changelog137Desc1": {
    "message": "Kui oled uinunud kaardi vaatamiseks äratanud, paneb hüpikaknas ja külgpaneelil olev uus nupp Pane see kaart uinakule ainult selle kaardi uuesti uinakule. Esmalt lülitab see sind teisele kaardile, sest vaadatavat kaarti ei saa uinakule panna."
  }
