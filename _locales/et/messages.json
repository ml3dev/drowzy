  "privacyShortText": {
    "message": "Drowzy ei kogu mingeid andmeid. Pole analüütikat, pole jälgimist, pole välisservereid. Kõik jääb sinu brauserisse."
  },
  "privacyStoredTitle": {
    "message": "Mis salvestatakse"
  },
  "privacyStoredText": {
    "message": "Sinu seaded (peatamise taimer, lubatud nimekiri, eelistused) salvestatakse Chrome'i sisseehitatud salvestamise API-de kaudu: chrome.storage.sync seadete jaoks, mis järgnevad sinu Chrome'i profiilile, chrome.storage.local statistika ja salvestatud seansside jaoks ning chrome.storage.session ajutiste andmete jaoks, nagu vahelehtede ajatemplid. Midagi sellest ei saadeta ühelegi kolmanda osapoole serverile."
  },
  "privacyPermissionsTitle": {
    "message": "Õigused"
  },
  "privacyPermissionsIntro": {
