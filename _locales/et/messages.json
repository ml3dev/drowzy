  "changelog136Title1": {
    "message": "Nüüd on kõik keeled täielikult tõlgitud"
  },
  "changelog136Desc1": {
    "message": "Mõned tekstid (lubatud nimekirja teated, rida Klaviatuuri otseteed ja Jaga statistikat tekst) kuvati teistes keeltes endiselt inglise keeles. Need on nüüd tõlgitud kõigisse 57 keelde ning paremalt vasakule kirjutatavad keeled nagu araabia ja heebrea keel kuvatakse samuti õigesti."
  },
  "changelog136Title2": {
    "message": "Tagasihoidlikum arvustuse küsimine"
  },
  "changelog136Desc2": {
    "message": "Riba „Kas Drowzy meeldib?“ ilmub nüüd alles siis, kui oled Drowzyt mõnda aega kasutanud, mitte kunagi paigaldamisel ega kohe pärast värskendust. Nupud on „Jäta arvustus“, „Võib-olla hiljem“ ja „Ära küsi uuesti“. See ei küsi kunagi kindlat hinnangut ega paku tasu."
  },
  "changelogReleaseHeading": {
    "message": "Mis on uut versioonis"
  },
  "changelog135Title1": {
    "message": "Kiirem ja nutikam peatamine"
  },
  "changelog135Desc1": {
    "message": "Vaiketaimer on nüüd 15 minutit, et märkaksid mälusäästu varem, ning teiste vahelehtede peatamine ja duplikaatide sulgemine on töökindlamad."
  },
  "changelog135Title2": {
    "message": "Lubatud nimekirja on lihtsam hallata"
  },
  "changelog135Desc2": {
    "message": "Selgemad eemaldusnupud, kinnitusteated ja loendur, ning nüüd töötab see ka localhosti ja IP-aadressidega."
  },
  "changelog135Title3": {
    "message": "Klaviatuuri otseteed seadetes"
