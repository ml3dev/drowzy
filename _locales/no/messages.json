  "onboardingTitle": {
    "message": "Velkommen til Drowzy"
  },
  "onboardingIntro": {
    "message": "Drowzy sparer minne ved å sette inaktive faner i dvale. Fanene dine er alltid trygge – vi bruker Chrome sin innebygde forkastings-API, så de overlever selv om du avinstallerer Drowzy."
  },
