  "privacyUpdated": {
    "message": "Sist oppdatert: april 2026"
  },
  "privacyShortText": {
    "message": "Drowzy samler ikke inn noen data. Ingen analyse, ingen sporing, ingen eksterne servere. Alt forblir i nettleseren din."
  },
  "privacyStoredTitle": {
    "message": "Hva som lagres"
  },
  "privacyStoredText": {
    "message": "Innstillingene dine (suspenderingstimer, hviteliste, preferanser) lagres med Chrome sine innebygde lagrings-APIer: chrome.storage.sync for innstillinger som følger Chrome-profilen din, chrome.storage.local for statistikk og lagrede økter, og chrome.storage.session for midlertidige data som fanetidsstempler. Ingenting av dette sendes til noen tredjepartsserver."
  },
