  "privacyPermHost": {
    "message": "Valgfri vertstilgang, forespurt på forespørsel kun når du aktiverer Skjemabeskyttelse eller Markering av suspenderte faner. Aldri bedt om ved installasjon. Kan tilbakekalles når som helst."
  },
  "privacyContactTitle": {
