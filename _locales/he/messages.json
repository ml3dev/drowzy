  "privacyUpdated": {
    "message": "עדכון אחרון: אפריל 2026"
  },
  "privacyShortText": {
    "message": "Drowzy לא אוסף שום נתונים. ללא ניתוח, ללא מעקב, ללא שרתים חיצוניים. הכל נשאר בדפדפן שלך."
  },
  "privacyStoredTitle": {
    "message": "מה נשמר"
  },
  "privacyStoredText": {
    "message": "ההגדרות שלך (טיימר השעיה, רשימה לבנה, העדפות) נשמרות באמצעות ממשקי האחסון המובנים של Chrome: ‏chrome.storage.sync להגדרות שעוקבות אחרי פרופיל Chrome שלך, chrome.storage.local לסטטיסטיקות והפעלות שמורות, ו-chrome.storage.session לנתונים זמניים כמו חותמות זמן של כרטיסיות. שום דבר מזה לא נשלח לשרת צד שלישי."
  },
  "privacyPermissionsTitle": {
    "message": "הרשאות"
  },
  "privacyPermissionsIntro": {
    "message": "Drowzy מבקש רק את ההרשאות שהוא צריך כדי לבצע את העבודה היחידה שלו:"
  },
  "privacyPermTabs": {
    "message": "רישום, השעיה ושחזור לשוניות דפדפן."
  },
  "privacyPermStorage": {
    "message": "שמירת ההגדרות והפעלות שלך באופן מקומי."
  },
  "privacyPermAlarms": {
    "message": "בדיקות תקופתיות של לשוניות לא פעילות (כל 60 שניות)."
  },
  "privacyPermContextMenus": {
    "message": "אפשרויות תפריט קליק ימני להשעיה ולרשימה הלבנה."
  },
  "privacyPermScripting": {
    "message": "הזרקת סקריפט קטן לזיהוי נתוני טופס לא שמורים לפני השעיית לשונית. הצטרפות בלבד."
  },
  "privacyPermSidePanel": {
    "message": "הצגת Drowzy בלוח הצד של Chrome."
  },
  "privacyPermHost": {
    "message": "גישת מארח אופציונלית, מבוקשת לפי דרישה רק כאשר אתה מפעיל הגנת טפסים או סימון לשוניות מושעות. לעולם לא מבוקשת בהתקנה. ניתן לבטל בכל עת."
