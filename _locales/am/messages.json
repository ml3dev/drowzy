  "changelog136Title1": {
    "message": "አሁን ሁሉም ቋንቋዎች ሙሉ በሙሉ ተተርጉመዋል"
  },
  "changelog136Desc1": {
    "message": "አንዳንድ ጽሑፎች (የነጭ ዝርዝር ማሳወቂያዎች፣ የቁልፍ ሰሌዳ አቋራጮች ረድፍ እና የስታቲስቲክስ ማጋሪያ ጽሑፍ) በሌሎች ቋንቋዎች አሁንም በእንግሊዝኛ ይታዩ ነበር። አሁን ወደ ሁሉም 57 ቋንቋዎች ተተርጉመዋል፣ እንዲሁም እንደ ዓረብኛ እና ዕብራይስጥ ካለ ቀኝ-ወደ-ግራ የሚጻፉ ቋንቋዎች በትክክል ይታያሉ።"
  },
  "changelog136Title2": {
    "message": "ይበልጥ ለስለስ ያለ የግምገማ ጥያቄ"
  },
  "changelog136Desc2": {
    "message": "«Drowzy ያስደስትዎታል?» የሚለው ባነር አሁን Drowzy ለተወሰነ ጊዜ ከተጠቀሙ በኋላ ብቻ ይታያል፣ በመጫን ጊዜ ወይም ወዲያው ከዝማኔ በኋላ ፈጽሞ አይታይም። አዝራሮቹ «ግምገማ ይተዉ»፣ «ምናልባት በኋላ» እና «ዳግመኛ አትጠይቅ» ናቸው። ፈጽሞ የተወሰነ የኮከብ ደረጃ አይጠይቅም ሽልማትም አያቀርብም።"
  },
  "changelogReleaseHeading": {
    "message": "አዲስ ነገር በ"
  },
  "changelog135Title1": {
    "message": "ፈጣን እና ብልጥ ማቋረጥ"
  },
  "changelog135Desc1": {
    "message": "ነባሪው ሰዓት ቆጣሪ አሁን 15 ደቂቃ ነው ስለዚህ የማስታወሻ ቁጠባን ቀድመው ያስተውላሉ፣ ሌሎች ትሮችን ማቋረጥ እና ድግግሞሽ ትሮችን መዝጋት የበለጠ አስተማማኝ ሆኗል።"
  },
