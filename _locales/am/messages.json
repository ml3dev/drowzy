  },
  "changelog135Desc2": {
    "message": "ይበልጥ ግልጽ የማስወገጃ አዝራሮች፣ የማረጋገጫ መልዕክቶች እና ቆጠራ፣ እንዲሁም አሁን ለlocalhost እና ለIP አድራሻዎች ይሰራል።"
  },
  "changelog135Title3": {
    "message": "በቅንብሮች ውስጥ የቁልፍ ሰሌዳ አቋራጮች"
  },
  "changelog135Desc3": {
    "message": "በቅንብሮች ውስጥ አዲስ ረድፍ የአቋራጮችን ሁኔታ ያሳያል እና በቀጥታ ወደ ማበጀቻቸው ይወስዳል።"
  },
  "changelog135Title4": {
    "message": "የስታቲስቲክስ እና የማጋራት ማሻሻያዎች"
  },
  "changelog135Desc4": {
    "message": "ስታቲስቲክስ አጋራ አሁን በቋንቋዎ ይታያል፣ የማስታወሻ ድምሮችም በንጹህ ይታያሉ፣ ለምሳሌ ከ2.0 ጊባ ይልቅ 2 ጊባ።"
  },
  "changelog135Title5": {
    "message": "ማሳመር እና ተደራሽነት"
  },
  "changelog135Desc5": {
    "message": "ይበልጥ ግልጽ አዶዎች፣ ከብራንዱ ቀለም ጋር የሚስማማ የመሣሪያ አሞሌ ባጅ፣ ለስክሪን አንባቢ የተሻሉ መለያዎች እና ይበልጥ የተስተካከለ ብቅ-ባይ።"
  },
  "suspendThisTabHint": {
    "message": "ወደ ሌላ ትር ይቀይሩ እና ይህን እንዲተኛ ያድርጉ"
  },
  "changelog137Title1": {
    "message": "አንድ ትርን እንደገና ያስተኛ"
  },
  "changelog137Desc1": {
    "message": "የተኛን ትር ለማየት ካነቁ በኋላ፣ በብቅ-ባይ መስኮትና በጎን ፓነል ላይ ያለው አዲሱ 'ይህን ትር አስተኛ' ቁልፍ ያን ትር ብቻ እንደገና ያስተኛል። እርስዎ የሚመለከቱት ትር ሊተኛ ስለማይችል መጀመሪያ ወደ ሌላ ትር ይቀይርዎታል።"
  }
}
