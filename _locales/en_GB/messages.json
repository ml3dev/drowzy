  "onboardingTitle": {
    "message": "Welcome to Drowzy"
  },
  "onboardingIntro": {
    "message": "Drowzy saves memory by putting inactive tabs to sleep. Your tabs are always safe – we use Chrome's native discard API, so they survive even if you uninstall Drowzy."
  },
  "howItWorks": {
    "message": "How it works"
  },
  "featureAutoSuspend": {
    "message": "<strong>Tabs idle for 30 minutes</strong> are automatically suspended"
  },
  "featureZeroRam": {
    "message": "<strong>Suspended tabs use zero RAM</strong> but stay in your tab bar"
  },
  "featureClickToWake": {
    "message": "<strong>Click any suspended tab</strong> to instantly wake it up"
  },
  "featureProtected": {
    "message": "<strong>Active, pinned, and audio tabs</strong> are never touched"
  },
