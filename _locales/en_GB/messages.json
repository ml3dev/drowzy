  },
  "privacyPermStorage": {
    "message": "storage – saving your settings locally"
  },
  "privacyPermAlarms": {
    "message": "alarms – periodic checks for inactive tabs"
  },
  "privacyPermContextMenus": {
    "message": "contextMenus – right-click menu options"
  },
