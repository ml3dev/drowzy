  "changelogReviewPromptTitle": {
    "message": "Review Prompt"
  },
  "changelogReviewPromptDesc": {
    "message": "After you've suspended a few tabs, Drowzy will gently ask if you're enjoying it. A quick thumbs up helps us a lot!"
  },
  "changelogChangelogTitle": {
    "message": "Changelog Page"
  },
  "changelogChangelogDesc": {
    "message": "You're looking at it! Opens automatically on update so you always know what changed. Access it anytime from Settings."
  },
  "changelogSessionRestoreTitle": {
    "message": "Session Restore Timing"
  },
  "changelogSessionRestoreDesc": {
    "message": "Restored tabs no longer get auto-suspended immediately. They now properly reset their idle timers on creation."
  },
  "changelogFormCheckTitle": {
    "message": "Form Check Timeout"
  },
  "changelogFormCheckDesc": {
    "message": "The form data check now has a 500ms timeout so unresponsive tabs can't block the entire suspension queue."
  },
  "changelogWhitelistDupesTitle": {
    "message": "Whitelist Duplicates"
  },
  "changelogWhitelistDupesDesc": {
    "message": "Fixed case sensitivity issue where \"Example.com\" and \"example.com\" could both be added. All entries are now normalised."
  },
  "changelogLiveStatsTitle": {
    "message": "Live Stats"
  },
  "changelogLiveStatsDesc": {
    "message": "The popup now refreshes automatically when tabs are suspended or woken in the background. No more stale numbers."
  },
  "changelogSessionOptionsTitle": {
    "message": "Session Restore Options"
  },
  "changelogSessionOptionsDesc": {
    "message": "Sessions now have separate \"Open\" (add tabs) and \"Replace\" (swap current tabs) buttons so you know exactly what will happen."
  },
  "changelogWhitelistValTitle": {
    "message": "Whitelist Validation & Export/Import"
  },
  "changelogWhitelistValDesc": {
    "message": "Whitelist input now validates domains. You can also export your whitelist and import it on another device via clipboard."
  },
  "changelogA11yTitle": {
    "message": "Accessibility"
  },
  "changelogA11yDesc": {
    "message": "Tab list items are now keyboard-navigable with proper ARIA roles. Toast notifications are announced to screen readers."
  },
  "changelogAnimationsTitle": {
    "message": "Smoother Animations"
  },
  "changelogAnimationsDesc": {
    "message": "Tab list stagger animations are now capped so windows with many tabs don't have a long cascade delay."
  },
  "changelogCtaText": {
    "message": "Drowzy is free and open source. If it's saving you memory, consider leaving a quick review or starring us on GitHub."
  },
  "changelogReviewBtn": {
    "message": "Leave a Review"
  },
  "changelogStarBtn": {
    "message": "Star on GitHub"
  }
