  "privacyTitle": {
    "message": "Drowzy – Privacy Policy"
  },
  "privacyUpdated": {
    "message": "Last updated: February 2026"
  },
  "privacyShortTitle": {
    "message": "The short version"
  },
  "privacyShortText": {
    "message": "Drowzy doesn't collect any data. No analytics, no tracking, no external servers. Everything stays in your browser."
  },
  "privacyStoredTitle": {
    "message": "What gets stored"
  },
  "privacyStoredText": {
    "message": "Your settings (suspend timer, whitelist, preferences) are saved using Chrome's built-in storage APIs: chrome.storage.sync for settings that follow your Chrome profile, chrome.storage.local for stats and saved sessions, and chrome.storage.session for temporary data like tab timestamps. None of this is sent to any third-party server."
  },
  "privacyPermissionsTitle": {
    "message": "Permissions"
  },
  "privacyPermissionsIntro": {
    "message": "Drowzy uses these Chrome permissions:"
  },
