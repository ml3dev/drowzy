  "privacyShortText": {
    "message": "Drowzy verzamelt geen gegevens. Geen analytics, geen tracking, geen externe servers. Alles blijft in je browser."
  },
  "privacyStoredTitle": {
    "message": "Wat wordt opgeslagen"
  },
  "privacyStoredText": {
    "message": "Je instellingen (opschorttimer, witte lijst, voorkeuren) worden opgeslagen met Chrome's ingebouwde opslag-API's: chrome.storage.sync voor instellingen die je Chrome-profiel volgen, chrome.storage.local voor statistieken en opgeslagen sessies, en chrome.storage.session voor tijdelijke gegevens zoals tabblad-timestamps. Niets hiervan wordt naar een externe server gestuurd."
  },
