  },
  "privacyPermScripting": {
    "message": "Indsprøjtning af et lille script for at registrere ugemte formulardata, før en fane suspenderes. Kun tilvalg."
  },
  "privacyPermSidePanel": {
    "message": "Visning af Drowzy i Chromes sidepanel."
  },
  "privacyPermHost": {
    "message": "Valgfri værtsadgang, anmodes kun efter behov, når du aktiverer Formularbeskyttelse eller Markering af suspenderede faner. Anmodes aldrig ved installation. Kan altid tilbagekaldes."
  },
  "privacyContactTitle": {
    "message": "Kontakt"
  },
  "privacyContactText": {
    "message": "Spørgsmål? Skriv til drowzyextension@gmail.com"
  },
  "privacyYourDataTitle": {
    "message": "Dine data"
  },
  "privacyYourDataText": {
    "message": "Da intet forlader din browser, er der intet dashboard, ingen konto og ingen måde for os at se, hvad du har gjort med Drowzy. Hvis du afinstallerer Drowzy, tilbyder Chrome dig muligheden for at sende valgfri feedback (årsag til afinstallation, browser, OS) via en separat webside; denne indsendelse er eksplicit og går til en anonym formular. Du kan springe det over ved at lukke fanen."
  },
