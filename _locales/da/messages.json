  "onboardingTitle": {
    "message": "Velkommen til Drowzy"
  },
  "onboardingIntro": {
    "message": "Drowzy sparer hukommelse ved at sætte inaktive faneblade i dvale. Dine faneblade er altid sikre – vi bruger Chromes native discard-API, så de overlever selv hvis du afinstallerer Drowzy."
  },
  "howItWorks": {
    "message": "Sådan fungerer det"
  },
