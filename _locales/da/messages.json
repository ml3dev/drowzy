  "privacyTitle": {
    "message": "Privatlivspolitik"
  },
  "privacyUpdated": {
    "message": "Sidst opdateret: april 2026"
  },
  "privacyShortText": {
    "message": "Drowzy indsamler ingen data. Ingen analyse, ingen sporing, ingen eksterne servere. Alt forbliver i din browser."
  },
  "privacyStoredTitle": {
    "message": "Hvad der gemmes"
  },
  "privacyStoredText": {
    "message": "Dine indstillinger (suspenderingstimer, hvidliste, præferencer) gemmes ved hjælp af Chromes indbyggede lagrings-API'er: chrome.storage.sync til indstillinger der følger din Chrome-profil, chrome.storage.local til statistik og gemte sessioner og chrome.storage.session til midlertidige data som faneblads-tidsstempler. Intet af dette sendes til nogen tredjepartsserver."
  },
  "privacyPermissionsTitle": {
    "message": "Tilladelser"
  },
  "privacyPermissionsIntro": {
    "message": "Drowzy beder kun om de tilladelser, det skal bruge for at udføre sit ene job:"
  },
  "privacyPermTabs": {
    "message": "Listning, suspendering og gendannelse af browserfaner."
  },
  "privacyPermStorage": {
    "message": "Lokal lagring af dine indstillinger og sessioner."
  },
  "privacyPermAlarms": {
