  "privacyTitle": {
    "message": "Privacy Policy"
  },
  "privacyUpdated": {
    "message": "Last updated: April 2026"
  },
  "privacyShortText": {
    "message": "Drowzy doesn't collect any data. No analytics, no tracking, no external servers. Everything stays in your browser."
  },
  "privacyStoredTitle": {
    "message": "What gets stored"
  },
  "privacyStoredText": {
    "message": "Your settings (suspend timer, whitelist, preferences) are saved using Chrome's built-in storage APIs: chrome.storage.sync for settings that follow your Chrome profile, chrome.storage.local for stats and saved sessions, and chrome.storage.session for temporary data like tab timestamps. None of this is sent to any third-party server."
  },
  "privacyPermissionsTitle": {
    "message": "Permissions"
  },
  "privacyPermissionsIntro": {
    "message": "Drowzy requests only the permissions it needs to do its one job:"
  },
  "privacyPermTabs": {
    "message": "Listing, suspending, and restoring browser tabs."
  },
  "privacyPermStorage": {
    "message": "Saving your settings and sessions locally."
  },
  "privacyPermAlarms": {
    "message": "Periodic checks for inactive tabs (every 60 seconds)."
  },
  "privacyPermContextMenus": {
    "message": "Right-click menu options for suspend and whitelist."
  },
  "privacyPermScripting": {
    "message": "Injecting a small script to detect unsaved form data before suspending a tab. Opt-in only."
  },
  "privacyPermSidePanel": {
    "message": "Displaying Drowzy in Chrome's side panel."
  },
  "privacyPermHost": {
    "message": "Optional host access, requested on-demand only when you enable Form Protection or Suspended-Tab Marking. Never requested at install. Revocable anytime."
  },
  "privacyContactTitle": {
    "message": "Contact"
  },
  "privacyContactText": {
    "message": "Questions? Reach out at drowzyextension@gmail.com"
  },
  "privacyYourDataTitle": {
    "message": "Your data"
  },
  "privacyYourDataText": {
    "message": "Because nothing leaves your browser, there's no dashboard, no account, and no way for us to see what you've done with Drowzy. If you uninstall Drowzy, Chrome offers you a chance to send optional feedback (reason for uninstalling, browser, OS) through a separate web page; that submission is explicit and goes to an anonymous form. You can skip it by closing the tab."
  },
