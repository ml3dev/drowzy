  },
  "actionAltS": {
    "message": "Press <kbd>Alt+S</kbd> to suspend the current tab"
  },
  "actionAltShiftS": {
    "message": "Press <kbd>Alt+Shift+S</kbd> to suspend all other tabs"
  },
  "actionAltW": {
    "message": "Press <kbd>Alt+W</kbd> to wake all suspended tabs"
  },
  "actionRightClick": {
    "message": "Right-click on any page for quick suspend options"
  },
