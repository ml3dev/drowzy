  "onboardingTitle": {
    "message": "Drowzy-க்கு வரவேற்கிறோம்"
  },
  "onboardingIntro": {
    "message": "Drowzy செயலற்ற தாவல்களைத் தூங்க வைப்பதன் மூலம் நினைவகத்தைச் சேமிக்கிறது. உங்கள் தாவல்கள் எப்போதும் பாதுகாப்பாக உள்ளன – Chrome-ன் நேட்டிவ் discard API-ஐ பயன்படுத்துகிறோம், எனவே Drowzy-ஐ நிறுவல் நீக்கினாலும் அவை பிழைக்கும்."
  },
  "howItWorks": {
    "message": "இது எப்படி வேலை செய்கிறது"
  },
  "featureAutoSuspend": {
    "message": "<strong>30 நிமிடங்கள் செயலற்ற தாவல்கள்</strong> தானாக இடைநிறுத்தப்படும்"
  },
  "featureZeroRam": {
    "message": "<strong>இடைநிறுத்தப்பட்ட தாவல்கள் RAM பயன்படுத்தாது</strong> ஆனால் தாவல் பட்டியில் இருக்கும்"
  },
  "featureClickToWake": {
    "message": "<strong>இடைநிறுத்தப்பட்ட எந்த தாவலையும் கிளிக் செய்யவும்</strong> உடனடியாக எழுப்ப"
  },
  "featureProtected": {
    "message": "<strong>செயலில் உள்ள, பின் செய்யப்பட்ட மற்றும் ஒலி தாவல்கள்</strong> ஒருபோதும் தொடப்படாது"
  },
  "quickActions": {
    "message": "விரைவு செயல்கள்"
  },
  "actionClickIcon": {
    "message": "உங்கள் அனைத்து தாவல்களையும் பார்க்க கருவிப்பட்டியில் <strong>Drowzy சின்னத்தை</strong> கிளிக் செய்யவும்"
  },
  "actionAltS": {
    "message": "தற்போதைய தாவலை இடைநிறுத்த <kbd>Alt+S</kbd> அழுத்தவும்"
  },
  "actionAltShiftS": {
    "message": "மற்ற அனைத்து தாவல்களையும் இடைநிறுத்த <kbd>Alt+Shift+S</kbd> அழுத்தவும்"
  },
  "actionAltW": {
    "message": "இடைநிறுத்தப்பட்ட அனைத்து தாவல்களையும் எழுப்ப <kbd>Alt+W</kbd> அழுத்தவும்"
  },
  "actionRightClick": {
    "message": "விரைவு இடைநிறுத்த விருப்பங்களுக்கு எந்தப் பக்கத்திலும் வலது கிளிக் செய்யவும்"
  },
  "onboardingCta": {
    "message": "Drowzy ஏற்கனவே இயங்குகிறது. சில தாவல்களைத் திறந்து முயற்சிக்கவும்!"
  },
  "onboardingBtn": {
    "message": "புரிந்தது, தொடங்குவோம்"
  },
  "privacyTitle": {
    "message": "Drowzy – தனியுரிமைக் கொள்கை"
  },
  "privacyUpdated": {
    "message": "கடைசியாக புதுப்பிக்கப்பட்டது: ஏப்ரல் 2026"
  },
  "privacyShortTitle": {
    "message": "சுருக்கமான பதிப்பு"
  },
  "privacyShortText": {
    "message": "Drowzy எந்த தரவையும் சேகரிக்காது. பகுப்பாய்வு இல்லை, கண்காணிப்பு இல்லை, வெளிப்புற சேவையகங்கள் இல்லை. எல்லாம் உங்கள் உலாவியில் இருக்கும்."
  },
  "privacyStoredTitle": {
    "message": "என்ன சேமிக்கப்படுகிறது"
  },
  "privacyStoredText": {
    "message": "உங்கள் அமைப்புகள் (இடைநிறுத்த நேரமானி, அனுமதிப்பட்டியல், விருப்பத்தேர்வுகள்) Chrome-ன் உள்ளமைக்கப்பட்ட சேமிப்பக API-களைப் பயன்படுத்தி சேமிக்கப்படுகின்றன: உங்கள் Chrome சுயவிவரத்தைப் பின்பற்றும் அமைப்புகளுக்கு chrome.storage.sync, புள்ளிவிவரங்கள் மற்றும் சேமிக்கப்பட்ட அமர்வுகளுக்கு chrome.storage.local, மற்றும் தாவல் நேர முத்திரைகள் போன்ற தற்காலிக தரவுக்கு chrome.storage.session. இதில் எதுவும் மூன்றாம் தரப்பு சேவையகத்திற்கு அனுப்பப்படாது."
  },
  "privacyPermissionsTitle": {
    "message": "அனுமதிகள்"
  },
  "privacyPermissionsIntro": {
    "message": "Drowzy இந்த Chrome அனுமதிகளைப் பயன்படுத்துகிறது:"
  },
  "privacyPermTabs": {
    "message": "tabs – உலாவி தாவல்களை பட்டியலிடுதல், இடைநிறுத்துதல் மற்றும் மீட்டெடுத்தல்"
  },
  "privacyPermStorage": {
    "message": "storage – உங்கள் அமைப்புகளை உள்ளூரில் சேமித்தல்"
  },
  "privacyPermAlarms": {
    "message": "alarms – செயலற்ற தாவல்களுக்கான கால இடைவெளி சோதனைகள்"
  },
  "privacyPermContextMenus": {
    "message": "contextMenus – வலது கிளிக் மெனு விருப்பங்கள்"
  },
  "privacyContactTitle": {
    "message": "தொடர்பு"
  },
  "privacyContactText": {
