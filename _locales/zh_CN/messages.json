  "onboardingTitle": {
    "message": "欢迎使用 Drowzy"
  },
  "onboardingIntro": {
    "message": "Drowzy 通过将不活跃的标签页置于休眠状态来节省内存。您的标签页始终安全 – 我们使用 Chrome 的原生丢弃 API，因此即使您卸载 Drowzy，标签页也不会丢失。"
  },
  "howItWorks": {
    "message": "工作原理"
  },
