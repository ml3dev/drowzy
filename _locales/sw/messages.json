  "onboardingTitle": {
    "message": "Karibu kwenye Drowzy"
  },
  "onboardingIntro": {
    "message": "Drowzy inaokoa kumbukumbu kwa kulaza tabo zisizotumika. Tabo zako ni salama kila wakati – tunatumia API asilia ya Chrome ya kutupa, hivyo zinaendelea hata ukiondoa Drowzy."
  },
  "howItWorks": {
    "message": "Jinsi inavyofanya kazi"
