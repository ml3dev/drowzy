  "privacyTitle": {
    "message": "Sera ya Faragha"
  },
  "privacyUpdated": {
    "message": "Ilisasishwa mwisho: Aprili 2026"
  },
  "privacyShortText": {
    "message": "Drowzy haikusanyi data yoyote. Hakuna uchambuzi, hakuna ufuatiliaji, hakuna seva za nje. Kila kitu kinabaki kwenye kivinjari chako."
  },
  "privacyStoredTitle": {
    "message": "Kinachohifadhiwa"
  },
  "privacyStoredText": {
    "message": "Mipangilio yako (kipima muda cha kusimamisha, orodha nyeupe, mapendeleo) yanahifadhiwa kwa kutumia API za uhifadhi zilizojengwa ndani ya Chrome: chrome.storage.sync kwa mipangilio inayofuata wasifu wako wa Chrome, chrome.storage.local kwa takwimu na vikao vilivyohifadhiwa, na chrome.storage.session kwa data ya muda kama mihuri ya wakati ya tabo. Hakuna kitu kinachotumwa kwa seva yoyote ya wahusika wengine."
  },
  "privacyPermissionsTitle": {
    "message": "Ruhusa"
  },
  "privacyPermissionsIntro": {
    "message": "Drowzy huomba tu ruhusa zinazohitajika kufanya kazi yake moja:"
  },
  "privacyPermTabs": {
    "message": "Kuorodhesha, kusitisha, na kurejesha vichupo vya kivinjari."
  },
  "privacyPermStorage": {
    "message": "Kuhifadhi mipangilio na vipindi vyako kwa ndani."
  },
  "privacyPermAlarms": {
    "message": "Ukaguzi wa mara kwa mara wa vichupo visivyofanya kazi (kila sekunde 60)."
  },
  "privacyPermContextMenus": {
    "message": "Chaguo za menyu ya bonyeza-kulia kwa kusitisha na orodha nyeupe."
  },
  "privacyPermScripting": {
    "message": "Kudunga hati ndogo ili kugundua data ya fomu ambayo haijahifadhiwa kabla ya kusitisha kichupo. Chaguo tu."
  },
  "privacyPermSidePanel": {
    "message": "Kuonyesha Drowzy katika paneli ya kando ya Chrome."
  },
  "privacyPermHost": {
    "message": "Ufikiaji wa mwenyeji wa hiari, unaombwa kwa ombi tu unapowezesha Ulinzi wa Fomu au Kuashiria Vichupo Vilivyositishwa. Kamwe haombiwi wakati wa usakinishaji. Inaweza kufutwa wakati wowote."
  },
  "privacyContactTitle": {
    "message": "Mawasiliano"
  },
  "privacyContactText": {
    "message": "Maswali? Wasiliana nasi kupitia drowzyextension@gmail.com"
  },
  "privacyYourDataTitle": {
    "message": "Data yako"
  },
  "privacyYourDataText": {
    "message": "Kwa sababu hakuna kinachoondoka kwenye kivinjari chako, hakuna dashibodi, hakuna akaunti, na hakuna njia kwetu kuona ulichofanya na Drowzy. Ukifuta Drowzy, Chrome inakupa fursa ya kutuma maoni ya hiari (sababu ya kufuta, kivinjari, OS) kupitia ukurasa tofauti wa wavuti; uwasilishaji huo ni wazi na unaenda kwa fomu isiyojulikana. Unaweza kuruka kwa kufunga kichupo."
  },
