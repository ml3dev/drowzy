  "privacyTitle": {
    "message": "Integritetspolicy"
  },
  "privacyUpdated": {
    "message": "Senast uppdaterad: april 2026"
  },
  "privacyShortText": {
    "message": "Drowzy samlar inte in någon data. Ingen analys, ingen spårning, inga externa servrar. Allt stannar i din webbläsare."
  },
  "privacyStoredTitle": {
    "message": "Vad som lagras"
  },
  "privacyStoredText": {
    "message": "Dina inställningar (suspenderingstimer, vitlista, preferenser) sparas med Chromes inbyggda lagrings-API:er: chrome.storage.sync för inställningar som följer din Chrome-profil, chrome.storage.local för statistik och sparade sessioner, och chrome.storage.session för tillfällig data som flikars tidsstämplar. Inget av detta skickas till någon tredjepartsserver."
  },
