{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.4",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["tabs", "storage", "alarms", "contextMenus", "scripting", "sidePanel"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "__MSG_extName__"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "suspend-current": {
      "suggested_key": {
        "default": "Alt+S",
        "windows": "Alt+Shift+Z"
      },
      "description": "__MSG_commandSuspendCurrent__"
    },
    "suspend-others": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "__MSG_commandSuspendOthers__"
    },
    "wake-all": {
      "suggested_key": {
        "default": "Alt+W",
        "windows": "Alt+Shift+W"
      },
      "description": "__MSG_commandWakeAll__"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "120"
}
